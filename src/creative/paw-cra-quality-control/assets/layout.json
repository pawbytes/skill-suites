{
  "suite": "creative",
  "title": "PawBytes Creative Suites",
  "config_section": "cra",
  "root": "paw-suites/creative",
  "legacy_root": ".pawbytes/creative-suites",
  "items": ["brands/*"],
  "rules": [
    {"from": "index.md", "to": "_memory/index.md"},
    {"from": "tool-status.md", "to": "_memory/tool-status.md"},
    {"from": "daily/**", "to": "_memory/daily/{rest}"},
    {"from": "knowledge/**", "to": "_memory/knowledge/{rest}"},
    {"from": ".auth/**", "to": "/.pawbytes/creative/.auth/{rest}"},
    {"from": ".profiles/**", "to": "/.pawbytes/creative/.profiles/{rest}"},

    {"from": "output/clips/**", "to": "brands/unassigned/videos/clips/{rest}"},
    {"from": "campaigns/*/assets/images/**", "to": "brands/unassigned/campaigns/{1}/designs/{rest}"},
    {"from": "campaigns/*/assets/videos/**", "to": "brands/unassigned/campaigns/{1}/videos/{rest}"},
    {"from": "campaigns/*/assets/copy/**", "to": "brands/unassigned/campaigns/{1}/copy/{rest}"},
    {"from": "campaigns/*/assets/**", "to": "brands/unassigned/campaigns/{1}/designs/{rest}"},
    {"from": "campaigns/**", "to": "brands/unassigned/campaigns/{rest}"},
    {"from": "briefs/**", "to": "brands/unassigned/briefs/{rest}"},

    {"from": "brands/*/assets/brand-identity/**", "to": "brands/{1}/brand-assets/{rest}"},
    {"from": "brands/*/assets/logo/**", "to": "brands/{1}/brand-assets/logo/{rest}"},
    {"from": "brands/*/assets/icons/**", "to": "brands/{1}/brand-assets/icons/{rest}"},
    {"from": "brands/*/assets/banners/**", "to": "brands/{1}/brand-assets/banners/{rest}"},
    {"from": "brands/*/assets/avatars/**", "to": "brands/{1}/brand-assets/avatars/{rest}"},
    {"from": "brands/*/assets/video/**", "to": "brands/{1}/brand-assets/video/{rest}"},
    {"from": "brands/*/assets/wip/**", "to": "brands/{1}/designs/wip/{rest}"},
    {"from": "brands/*/assets/social/**", "to": "brands/{1}/designs/social/{rest}"},
    {"from": "brands/*/assets/carousels/**", "to": "brands/{1}/designs/carousels/{rest}"},
    {"from": "brands/*/assets/flyers/**", "to": "brands/{1}/designs/flyers/{rest}"},
    {"from": "brands/*/assets/resized/**", "to": "brands/{1}/designs/resized/{rest}"},
    {"from": "brands/*/assets/*", "to": "brands/{1}/brand-assets/{2}"},
    {"from": "brands/*/assets/*/social/**", "to": "brands/{1}/campaigns/{2}/designs/social/{rest}"},
    {"from": "brands/*/assets/*/carousels/**", "to": "brands/{1}/campaigns/{2}/designs/carousels/{rest}"},
    {"from": "brands/*/assets/*/flyers/**", "to": "brands/{1}/campaigns/{2}/designs/flyers/{rest}"},
    {"from": "brands/*/assets/*/resized/**", "to": "brands/{1}/campaigns/{2}/designs/resized/{rest}"},
    {"from": "brands/*/campaigns/*/assets/**", "to": "brands/{1}/campaigns/{2}/designs/{rest}"},
    {"from": "brands/*/assets/*/**", "to": "brands/{1}/campaigns/{2}/designs/{rest}"},

    {"from": "brands/*/videos/*", "to": "brands/{1}/videos/short-form/{2}"},
    {"from": "brands/*/videos/short-form/**", "to": "brands/{1}/videos/short-form/{rest}"},
    {"from": "brands/*/videos/long-form/**", "to": "brands/{1}/videos/long-form/{rest}"},
    {"from": "brands/*/videos/clips/**", "to": "brands/{1}/videos/clips/{rest}"},
    {"from": "brands/*/videos/motion-graphics/**", "to": "brands/{1}/videos/motion-graphics/{rest}"},
    {"from": "brands/*/videos/series/**", "to": "brands/{1}/videos/series/{rest}"},
    {"from": "brands/*/videos/audio/**", "to": "brands/{1}/videos/audio/{rest}"},
    {"from": "brands/*/videos/.work/**", "to": "brands/{1}/videos/.work/{rest}"},
    {"from": "brands/*/videos/*/short-form/**", "to": "brands/{1}/campaigns/{2}/videos/short-form/{rest}"},
    {"from": "brands/*/videos/*/long-form/**", "to": "brands/{1}/campaigns/{2}/videos/long-form/{rest}"},
    {"from": "brands/*/videos/*/clips/**", "to": "brands/{1}/campaigns/{2}/videos/clips/{rest}"},
    {"from": "brands/*/videos/*/audio/**", "to": "brands/{1}/campaigns/{2}/videos/audio/{rest}"},
    {"from": "brands/*/videos/*/series/**", "to": "brands/{1}/campaigns/{2}/videos/series/{rest}"},
    {"from": "brands/*/videos/*/motion-graphics/**", "to": "brands/{1}/campaigns/{2}/videos/motion-graphics/{rest}"},
    {"from": "brands/*/videos/*/**", "to": "brands/{1}/videos/long-form/{2}/{rest}"},

    {"from": "brands/*/exports/*", "to": "brands/{1}/exports/{2}"},
    {"from": "brands/*/exports/*/**", "to": "brands/{1}/campaigns/{2}/exports/{rest}"}
  ],
  "config_keys": [
    {"key": "output_directory", "legacy": "{project-root}/.pawbytes/creative-suites",
     "new": "{project-root}/paw-suites/creative"}
  ]
}
